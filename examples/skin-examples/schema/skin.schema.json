{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metasequoiaime.github.io/schemas/skin-v1.schema.json",
  "title": "Metasequoia IME candidate skin",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "base",
    "stylesheet",
    "supports",
    "candidateWindow",
    "license"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "author": { "type": "string", "maxLength": 120 },
    "description": { "type": "string", "maxLength": 500 },
    "base": { "enum": ["fluent", "wechat", "graphite", "willow_green"] },
    "stylesheet": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+\\.css$"
    },
    "preview": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "supports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layouts", "themes"],
      "properties": {
        "layouts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["horizontal", "vertical"] }
        },
        "themes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["dark", "light"] }
        }
      }
    },
    "candidateWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decoration"],
      "properties": {
        "minWidthDip": { "type": "number", "minimum": 0, "maximum": 1000 },
        "decoration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["topInsetDip", "widthDip"],
          "properties": {
            "topInsetDip": { "type": "number", "minimum": 0, "maximum": 500 },
            "widthDip": { "type": "number", "minimum": 0, "maximum": 1000 }
          }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "assets"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 80 },
        "assets": { "type": "string", "minLength": 1, "maxLength": 120 },
        "source": { "type": "string", "maxLength": 500 }
      }
    }
  }
}
